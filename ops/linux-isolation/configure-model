#!/usr/bin/env python3
"""Update only the WHEREIS registry from a reviewed declarative provider profile."""
import json
from pathlib import Path
from engine import instance, registry

root = Path.home() / '.config/whereis-programador'
values = instance(root / 'instance.env')
profiles = json.loads(Path(__file__).with_name('provider-profiles.json').read_text())
path = root / 'xdg/opencode/opencode.json'
config = registry(values, profiles, json.loads(path.read_text()))
temporary = path.with_name(path.name + '.candidate')
with temporary.open('x') as stream:
    stream.write(json.dumps(config, indent=2) + '\n')
temporary.chmod(0o600)
temporary.replace(path)
print('WHEREIS provider registry updated; no credentials loaded')
